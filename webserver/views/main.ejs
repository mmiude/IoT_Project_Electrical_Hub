<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="/static/js/main_ui.js"></script>

</head>

<body>
    <div class="flex max-h-screen max-h-dvh min-h-screen min-h-dvh p-1 w-full gap-1">
        <!-- CHART -->
        <div class="p-2 flex-1 gap-1 flex flex-col rounded-md border-solid border-black border-1 shadow-sm" id="consumption_chart_card">
            <div class="w-full flex justify-between border-b border-slate-500 px-2 pb-1">
                <p>Consumption chart</p>
                <button class="hover:cursor-pointer hover:scale-105" onclick="consumptionChartCardFullScreen = ToggleCardSize(0)">
                    <img src="/static/icons/full_screen.png" alt="full_screen" id="consumption_chart_card_toggle_icon">
                </button>
            </div>

            <div class="relative h-96 w-full max-w-[600px] mx-auto">
                <canvas id="consumption_chart"></canvas>
            </div>

            <div class="w-full flex flex-col pt-5 gap-1">
                <div class="flex flex-col mb-2">
                    <div class="inline-flex items-center border border-black rounded-md bg-white">
                        <button name="show_chart_data" id="chart_data_day" class="py-1 flex-1 hover:opacity-80 transition-opacity cursor-pointer">
                            Day
                        </button>
                        <div class="h-6 w-[1px] bg-[#dcdbe8]"></div>

                        <button name="show_chart_data" id="chart_data_week" class="py-1 flex-1 hover:opacity-80 transition-opacity cursor-pointer">
                            Week
                        </button>
                        <div class="h-6 w-[1px] bg-[#dcdbe8]"></div>

                        <button name="show_chart_data" id="chart_data_month" class="py-1 flex-1 hover:opacity-80 transition-opacity cursor-pointer">
                            Month
                        </button>
                        <div class="h-6 w-[1px] bg-[#dcdbe8]"></div>

                        <button name="show_chart_data" id="chart_data_year" class="py-1 flex-1 hover:opacity-80 transition-opacity cursor-pointer">
                            Year
                        </button>
                    </div>
                </div>

                <div class="flex justify-between">
                    <span>Date:</span>
                    <input type="date" id="chart_data_by_date">
                </div>

                <div class="flex justify-between">
                    <span>Show on chart:</span>
                    <div class="inline-flex items-center gap-2">
                        <label for="switch-component-on_kwh_eur" class="text-slate-600 text-sm cursor-pointer">kWh</label>
                        
                        <div class="relative inline-block w-11 h-5">
                            <input id="switch-component-on_kwh_eur" type="checkbox" class="peer appearance-none w-11 h-5 bg-[#12005e] rounded-full cursor-pointer transition-colors duration-300" />
                            <label for="switch-component-on_kwh_eur" class="absolute top-0 left-0 w-5 h-5 bg-white rounded-full border border-slate-300 shadow-sm transition-transform duration-300 peer-checked:translate-x-6 peer-checked:border-slate-800 cursor-pointer">
                            </label>
                        </div>
                        
                        <label for="switch-component-on_kwh_eur" class="text-slate-600 text-sm cursor-pointer">Eur</label>
                    </div>
                </div>
                <div class="flex justify-between pr-7">
                    <span>Group by device:</span>
                    <div class="flex flex-col justify-center">

                        <div class="relative inline-block w-11 h-5">
                            <input 
                                id="group_by_device" 
                                type="checkbox" 
                                name="group_by_device"
                                class="peer appearance-none w-11 h-5 bg-slate-100 rounded-full checked:bg-[#12005e] cursor-pointer transition-colors duration-300" 
                            />
                            <label for="group_by_device" class="absolute top-0 left-0 w-5 h-5 bg-white rounded-full border border-slate-300 shadow-sm transition-transform duration-300 peer-checked:translate-x-6 peer-checked:border-slate-800 cursor-pointer">
                            </label>
                        </div>
                    </div>
                </div>
                <div class="flex justify-between pr-7">
                    <span>Current electricity price:</span>
                    <span><%= data.hub.electricity_price %> c/kWh</span>
                </div>

            </div>
        </div>

        <!-- DEVICES -->
        <div class="p-2 flex-1 gap-1 flex flex-col rounded-md border-solid border-black border-1 shadow-sm" id="devices_card">
            <div class="w-full flex justify-between border-b border-slate-500 px-2 pb-1">
                <p>Devices</p>
                <button class="hover:cursor-pointer hover:scale-105" onclick="deviceCardFullScreen = ToggleCardSize(1)">
                    <img src="/static/icons/full_screen.png" alt="full_screen" id="devices_card_toggle_icon">
                </button>
            </div>

            <div id="devices_container" class="flex flex-col gap-1 overflow-auto">
                <% data.hub.devices.forEach((device) => { %>
                    <div class="hover:bg-slate-200 rounded-md border-solid border-black border-1 w-full flex justify-between p-2">
                        <div class="flex flex-col">
                            <span 
                                id="device_name|<%= device.id %>"
                                contenteditable="true" 
                                class="outline-none hover:bg-gray-100 focus:bg-gray-100 focus:ring-2 focus:ring-blue-500 rounded px-1 py-0.5 transition"
                            >
                                <%= device.name %>
                            </span>
                            <select name="device_priority" id="device_priority|<%= device.id %>" class="text-sm w-fit border-none rounded cursor-pointer">
                                <option value="0" <%= device.priority === 'HIGH' ? 'selected' : '' %>>HIGH</option>
                                <option value="2" <%= device.priority === 'MED' ? 'selected' : '' %>>MED</option>
                                <option value="1" <%= device.priority === 'LOW' ? 'selected' : '' %>>LOW</option>
                            </select>
                        </div>
                        <div class="flex flex-col justify-center">
                            <div class="relative inline-block w-11 h-5">
                                <input 
                                    <%= device.is_on ? 'checked' : '' %> 
                                    id="device_on|<%= device.id %>" 
                                    type="checkbox" 
                                    name="device_on"
                                    class="peer appearance-none w-11 h-5 bg-slate-100 rounded-full checked:bg-green-400 cursor-pointer transition-colors duration-300" 
                                />
                                <label id="label_device_on|<%= device.id %>" for="device_on|<%= device.id %>" class="absolute top-0 left-0 w-5 h-5 bg-white rounded-full border border-slate-300 shadow-sm transition-transform duration-300 peer-checked:translate-x-6 peer-checked:border-slate-800 cursor-pointer">
                                </label>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- SETTINGS -->
        <div class="p-2 flex-1 flex gap-1 flex-col rounded-md border-solid border-black border-1 shadow-sm" id="settings_card">
            <div class="w-full flex justify-between border-b border-slate-500 px-2 pb-1">
                <p>Settings</p>
                <button class="hover:cursor-pointer hover:scale-105" onclick="settingsCardFullScreen = ToggleCardSize(2)">
                    <img src="/static/icons/full_screen.png" alt="full_screen" id="settings_card_toggle_icon">
                </button>
            </div>

            <div class="flex flex-col gap-1 h-full overflow-hidden">
                <div class="flex justify-between py-2 px-3 rounded-md border-1 border-solid border-black items-center">
                    <div class="flex flex-col">
                        <h1>Logged in as: </h1>
                        <div class="flex gap-1 items-center">
                            <img src="<%= data.user.profile_picture %>" alt="profile_picture" class=" border-solid border-black border-1 rounded-full w-[22.5px]">
                            <span class="text-sm"><%= data.user.name %></span>
                        </div>
                    </div>
                    <a href="/auth/logout" class="cursor-pointer flex items-center justify-center h-full px-4 rounded-md bg-red-500 text-white active:scale-95">
                        Log out
                    </a>
                </div>
                <div class="p-2 rounded-md border-1 border-solid border-black flex flex-col gap-2">
                    <div class="flex justify-between px-1">
                        <h1>Registered hub: <br><span class="text-sm"><%= data.hub.hub_id != null ? data.hub.hub_id : "No hub registered" %></span></h1>
                        <button 
                            <% if (data.hub.hub_id != null) { %>
                                class="cursor-pointer h-full px-4 rounded-md bg-red-500 text-white active:scale-95"
                                onclick='DeleteHub(
                                    <%- JSON.stringify(data.user.userId) %>,
                                    <%- JSON.stringify(data.user.access_token) %>                                
                                )'
                            <% } else { %>
                                class="cursor-pointer h-full px-4 rounded-md bg-[#12005e] text-white active:scale-95"
                                onclick='RegisterHub(
                                    <%- JSON.stringify(data.user.userId) %>,
                                    <%- JSON.stringify(data.user.access_token) %>
                                )'
                            <% } %>    
                        >
                            <%= data.hub.hub_id != null ? "Delete hub" : "Register new hub" %>
                        </button>
                    </div>

                    <div
                        <% if (data.hub.hub_id != null) { %>
                            class="text-sm pt-2 flex flex-col gap-1 px-1 border-t-1 border-solid border-black"
                        <% } else { %>
                            class="hidden"
                        <% } %>
                    >
                        <div class="flex justify-between items-center">
                            <span>MED devices price threshold (c/kWh):</span>
                            <input
                                id="THRESHOLD_MED"
                                name="threshold"
                                type="number"
                                class="[appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none field-sizing-content min-w-12 max-w-32 border rounded-md px-1"
                                value="<%= data.hub.threshold_med != null ? data.hub.threshold_med : 0 %>"
                            />
                        </div>
                        <div class="flex justify-between items-center">
                            <span>LOW devices price threshold (c/kWh):</span>
                            <input
                                id="THRESHOLD_LOW"
                                name="threshold"
                                type="number"
                                class="[appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none field-sizing-content min-w-12 max-w-32 border rounded-md px-1"
                                value="<%= data.hub.threshold_low != null ? data.hub.threshold_low : 0 %>"
                            />
                        </div>
                    </div>
                </div>
                <div class="flex flex-col p-2 border-1 border-solid border-black rounded-md flex-1 overflow-auto">
                    <h1 class="px-1">Logs:</h1>

                    <% if (data.hub.logs.length > 0) { %>
                    <%      data.hub.logs.forEach((log) => { %>
                                <div class="text-sm px-1 flex justify-between items-start border-b-1 border-solid border-black py-1">
                                    <div class="flex flex-col min-w-0 flex-1 border-r-1 border-solid border-black ">
                                        <span class="px-1 shrink-0">
                                            <b><%= new Date(new Date(log.timestamp).getTime() + 6 * 60 * 60 * 1000).toISOString() %></b>
                                        </span>
                                        <span class="break-all px-4"><%= log.log_text %></span>
                                    </div>
                                    
                                    <button
                                        class="cursor-pointer hover:scale-105 shrink-0 ml-2 flex items-center justify-center h-full"
                                        onclick="DeleteLog(<%= JSON.stringify(log.id) %>, <%= JSON.stringify(data.user.access_token) %>)"
                                    >
                                        <img src="/static/icons/delete.png" alt="delete_log" class="w-[20px]">
                                    </button>
                                </div>
                    <%      }) %>
                    <% } else { %>
                        <span class="text-sm px-1">No logs to show</span>
                    <% } %>
                </div>

            </div>
        </div>
    </div>

