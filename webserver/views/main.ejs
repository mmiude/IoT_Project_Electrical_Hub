        // const userId = <%- JSON.stringify(data.userId) %>;
        // const user_hub = <%- JSON.stringify(data.user_hub) %>;
        // const access_token = <%- JSON.stringify(data.access_token ) %>;
        // const device_readings = <%- JSON.stringify(data.device_readings) %>;
        // console.log(<%- JSON.stringify(data.device_readings) %>)
