    <div class="flex min-h-screen min-h-dvh p-1 w-full gap-1">
        <div class="p-2 flex-1 gap-1 flex flex-col rounded-md border-solid border-black border-1 shadow-sm" id="consumption_chart_card">
            <div class="w-full flex justify-between">
                <p>Consumption chart</p>
                <button class="hover:cursor-pointer hover:scale-105" onclick="consumptionChartCardFullScreen = ToggleCardSize(0)">
