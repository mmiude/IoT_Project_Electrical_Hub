<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<script type="text/javascript">
    async function test(access_token) {
        const req = await fetch("/api/test", {
            headers: {
                "Authorization": `Bearer ${access_token}`
            }
        })
        const res = await req.json()
        console.log(res)
        alert(res.success ? "yay" : "not so yay")
    }
</script>

<body>
    <h1>Logged in as <%= data.user %></h1>
    <button onclick="test('<%= data.access_token %>')">Test api</button>
</body>


</html>